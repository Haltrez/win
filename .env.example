# Canonical origin (no trailing slash). Used for canonicals, sitemaps, schema.
NEXT_PUBLIC_SITE_URL=https://www.example-slots.com
NEXT_PUBLIC_SITE_NAME=SpinVault
# Analytics (optional; leave empty to disable). Plausible domain OR GA4 measurement ID.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=
# Optional server-side webhook that receives affiliate click + web-vitals events (e.g. a Logflare/BigQuery/Segment endpoint).
EVENTS_WEBHOOK_URL=
# Set to "1" on staging/preview to noindex the whole site.
NEXT_PUBLIC_NOINDEX=
